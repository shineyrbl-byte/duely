# Claude (https://console.anthropic.com) — required for the AI features
ANTHROPIC_API_KEY=

# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave both blank to run in demo mode with an in-memory mock of the Invoicing API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook ID for INVOICING.INVOICE.PAID events (needs a public URL, e.g. on Render)
PAYPAL_WEBHOOK_ID=

# Who the invoices come from
INVOICER_NAME=Alex Rivera
INVOICER_BUSINESS=Rivera Design Studio
# Optional: must match your sandbox business account email if set
INVOICER_EMAIL=
DEFAULT_CURRENCY=USD
